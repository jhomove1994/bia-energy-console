# Optional overrides for docker compose. Copy to .env to use.
# Every variable has a working default; the demo needs none of them.

# Login for the web console
DEMO_USER=admin
DEMO_PASSWORD=admin123

# Secret used to sign session tokens. Change it outside a local demo.
AUTH_SECRET=change-me-demo

# Session lifetime (Go duration)
TOKEN_TTL=12h

# Pause per analysis stage in ms. 300 makes the progress visible; 0 disables it.
ANALYSIS_STAGE_DELAY_MS=300

# Host port for the web console
WEB_PORT=8080
